# Copy to .env and fill in. Never commit .env (it's gitignored).
CTMATCH_QDRANT_URL=http://localhost:6333
CTMATCH_COLLECTION=clinical_trials
CTMATCH_EMBED_MODEL=NeuML/pubmedbert-base-embeddings
CTMATCH_EMBED_DIM=768
CTMATCH_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Used from Milestone 3 onward — leave blank for now
CTMATCH_ANTHROPIC_API_KEY=
CTMATCH_LANGFUSE_PUBLIC_KEY=
CTMATCH_LANGFUSE_SECRET_KEY=
CTMATCH_LANGFUSE_HOST=https://cloud.langfuse.com
